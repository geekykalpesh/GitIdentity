{
  "name": "git-identity",
  "version": "1.0.4",
  "description": "Desktop app to manage multiple GitHub SSH identities and protect repository commits",
  "main": "dist-electron/main/index.js",
  "author": "GeekyKalpesh <geekykalpesh@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cert:generate": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-cert.ps1",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:msix": "npm run build && electron-builder --win appx",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -wml",
    "dist:signed": "powershell -ExecutionPolicy Bypass -Command \"$env:CSC_LINK='./certs/geekykalpesh-code-signing.pfx'; $env:CSC_KEY_PASSWORD='GitIdentity2026!'; npm run dist:win\""
  },
  "build": {
    "appId": "com.geekykalpesh.gitidentity",
    "productName": "GitIdentity",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "win": {
      "publisherName": "GeekyKalpesh",
      "icon": "resources/icon.png",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appx": {
      "applicationId": "GitIdentity",
      "identityName": "LoniBurhanpur.GitIdentity",
      "publisher": "CN=726BA665-AF92-49E8-825D-51C24EAB8B00",
      "publisherDisplayName": "LoniBurhanpur",
      "displayName": "GitIdentity",
      "minVersion": "10.0.17763.0",
      "showNameOnTiles": true,
      "artifactName": "${productName}-Windows-Store-${version}.msix"
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Windows-Installer-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-macOS-Installer-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-Linux-Installer-${version}.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^20.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.6"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true
  }
}
